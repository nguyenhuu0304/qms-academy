# Copy to .env.local and fill in values on your own machine.
# Never commit .env.local or paste secret values into chat.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret

# Supabase server-only credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Older Supabase projects may use SUPABASE_SERVICE_ROLE_KEY instead.

# Local certificate preview only. Ignored when NODE_ENV=production.
QMS_DEV_CERTIFICATE_BYPASS=false
